VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/transcribe

# Optional ECS wake endpoint. Leave empty unless Terraform enable_wake_endpoint
# has been applied and wake_backend_url is available.
VITE_WAKE_BACKEND_URL=
VITE_BACKEND_HEALTH_URL=http://127.0.0.1:8000/api/health
VITE_BACKEND_WAKE_TIMEOUT_SECONDS=120

# Keep aligned with backend SESSION_TIMEOUT/session_timeout_seconds.
VITE_MAX_SESSION_SECONDS=1800
