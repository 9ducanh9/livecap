VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/transcribe

# Same-origin CloudFront path for the IAM-protected wake Lambda.
# Leave empty for local development.
VITE_WAKE_BACKEND_URL=
VITE_BACKEND_HEALTH_URL=http://127.0.0.1:8000/api/health
VITE_BACKEND_WAKE_TIMEOUT_SECONDS=120

# Keep aligned with backend SESSION_TIMEOUT/session_timeout_seconds.
VITE_MAX_SESSION_SECONDS=1800

# Optional Cognito sign-in and personal transcript history. Values are public
# Terraform outputs after a reviewed apply; never put a client secret in Vite.
VITE_AUTH_ENABLED=false
# VITE_COGNITO_DOMAIN=livecap-dev.auth.ap-southeast-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=your-public-cognito-client-id
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/app
