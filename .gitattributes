# Normalize line endings to LF in the repository to stop spurious CRLF/LF
# churn in diffs. Git stores text files with LF; on checkout, developers on
# Windows may still see CRLF locally, but the index stays LF so `git status`
# stays clean after a one-time renormalize:
#
#   git add --renormalize .
#   git commit -m "Normalize line endings to LF"
#
* text=auto eol=lf

# Windows-native scripts keep CRLF on checkout.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
