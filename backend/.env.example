# LiveCap Backend environment configuration
# Copy this file to `.env` and fill in the values for your environment.
# Use an AWS profile for local development and the ECS task role in AWS.
# Never place AWS access keys in this file.

# --- AWS ---
# AWS region used for Transcribe, Translate, and S3.
AWS_REGION=ap-southeast-1

# --- Storage (Amazon S3) ---
# Name of the S3 bucket where exported transcripts are stored. Replace this
# example value for any environment that uses transcript export.
S3_BUCKET=livecap-transcripts

# Expiration (in seconds) for generated presigned download links.
# Default: 86400 (24 hours).
DOWNLOAD_LINK_EXPIRATION=86400

# --- Session ---
# Maximum session duration (in seconds) before the backend times out an
# active streaming session. Default: 1800 (30 minutes).
SESSION_TIMEOUT=1800

# Process-local abuse guard. Keep ECS max task count at 1 while these limits are
# in memory; use DynamoDB/Redis before scaling backend tasks above 1.
MAX_CONCURRENT_SESSIONS=4
MAX_SESSIONS_PER_IP=1

# Optional ECS idle scale-to-zero. Keep disabled for local development unless
# ECS_CLUSTER_NAME and ECS_SERVICE_NAME are configured and the task role has
# ecs:UpdateService permission.
ENABLE_IDLE_SCALE_DOWN=false
IDLE_SCALE_DOWN_GRACE_SECONDS=300
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=

# Fixed language code for Amazon Transcribe Streaming.
# Used only when BILINGUAL_DUAL_STREAM=false.
TRANSCRIBE_LANGUAGE_CODE=vi-VN

# Natural bilingual conversation mode. When true, the backend runs vi-VN and
# en-US Transcribe streams in parallel and arbitrates the finalized output.
BILINGUAL_DUAL_STREAM=true

# Temporary audio pipeline debug logs. Enable while tracing microphone ->
# WebSocket -> Transcribe audio flow, then disable to reduce log volume.
AUDIO_PIPELINE_DEBUG=false

# --- Meeting summary (DeepSeek) ---
# When enabled, participants can explicitly request AI meeting notes after a
# session. Stop itself never calls the model. The request includes finalized
# captions only; it is not persisted by the notes endpoint. Opt-in; needs
# both this flag AND a real DEEPSEEK_API_KEY below, or summaries are skipped.
# Off by default (no cost). (Previously Amazon Bedrock -- switched because
# every Anthropic model quota in this account's Bedrock region was 0.)
ENABLE_MEETING_SUMMARY=false
# DeepSeek API key (sk-...) from platform.deepseek.com. Leave blank locally
# to test that the feature gates correctly without making a real call.
DEEPSEEK_API_KEY=
# DeepSeek model name used for summaries (OpenAI-compatible chat completions).
DEEPSEEK_MODEL=deepseek-chat
# Minimum finalized segments before a summary is generated.
SUMMARY_MIN_SEGMENTS=3
# Max transcript characters sent to the model (cost/latency guard).
SUMMARY_MAX_INPUT_CHARS=12000
# Wall-clock budget (seconds) for one user-requested summary call.
SUMMARY_TIMEOUT_SECONDS=20

# --- Optional English enrichment (Amazon Polly and Amazon Comprehend) ---
# Both capabilities are disabled by default. Polly has no Vietnamese voice and
# Comprehend sentiment/key-phrase analysis is English only, so pass translated
# English text. Enabling either requires the matching least-privilege IAM policy
# through reviewed Terraform and a new backend task deployment.
ENABLE_TTS=false
TTS_VOICE_ID_EN=Joanna
ENABLE_TEXT_ANALYSIS=false

# --- Optional accounts and transcript history (Amazon Cognito + DynamoDB) ---
# Off by default. When true, WebSocket capture and transcript export require a
# Cognito access token. DynamoDB stores only owner metadata and the private S3
# object key; raw audio is never stored.
ENABLE_AUTH=false
COGNITO_USER_POOL_ID=
TRANSCRIPT_HISTORY_TABLE_NAME=livecap-transcript-history
TRANSCRIPT_HISTORY_RETENTION_DAYS=14

# --- Optional Stripe subscription billing (Pro/Business tiers) ---
# Off by default. When true, /api/billing/checkout-session and
# /api/billing/portal-session require a Cognito bearer token, and
# /api/billing/webhook verifies Stripe's signature on every request.
# Get STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET from the Stripe Dashboard;
# never commit real values. Price IDs come from Stripe Products with a
# `livecap_tier` metadata key set to "pro"/"business" (see stripe_billing.py).
ENABLE_STRIPE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
# Base URL the browser is redirected back to after Checkout/Portal.
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS ---
# Comma-separated exact frontend origins allowed to call the backend.
# Example: https://livecap.example.com,https://example.cloudfront.net
# Do not use "*" in production.
ALLOWED_ORIGIN=http://localhost:5173

# --- Logging (Amazon CloudWatch) ---
# CloudWatch log group used when the handler can initialize. If credentials or
# CloudWatch are unavailable, the backend falls back to stdout logging.
CLOUDWATCH_LOG_GROUP=livecap
