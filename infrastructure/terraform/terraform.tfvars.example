# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your deployment

# AWS Configuration
aws_region   = "ap-southeast-1"
environment  = "dev"
project_name = "livecap"

# S3 Bucket Names (must be globally unique)
# If left empty, bucket names will be auto-generated with account ID suffix
# frontend_bucket_name   = "my-company-livecap-frontend-dev"
# transcript_bucket_name = "my-company-livecap-transcripts-dev"

# Transcript Retention
transcript_retention_days = 14  # Auto-delete transcripts after 14 days

# ECS Task Configuration
ecs_task_cpu      = 512   # 0.5 vCPU
ecs_task_memory   = 1024  # 1 GB RAM

# ECS backend scale-to-zero. Keep max=1 while session limits are in-memory.
backend_desired_count = 0
backend_min_capacity  = 0
backend_max_capacity  = 1

# Target backend image must already exist in ECR under an immutable Git SHA.
backend_image_tag = "0000000" # Required: replace with the immutable Git SHA pushed to ECR.

# Blue/green gate. First apply with false and target_backend_desired_count=1,
# verify the target, then switch route_backend_to_target=true.
route_backend_to_target      = false
target_backend_desired_count = 1

autoscaling_target_cpu    = 70  # Scale out when CPU > 70%
autoscaling_target_memory = 80  # Scale out when memory > 80%

# Application Configuration
session_timeout_seconds           = 1800  # 30 minutes
download_link_expiration_seconds  = 86400 # 24 hours
max_concurrent_sessions           = 4
max_sessions_per_ip               = 1

# Cost guard. AWS Budget notifications are not real-time and can lag behind usage.
monthly_budget_limit_usd = 50
# Set an email to receive budget alerts. Two notifications are created when set:
# a FORECASTED alert at budget_forecast_alert_threshold_pct (default 80%) and an
# ACTUAL alert at 100%. Leave empty to skip creating budget notifications.
# budget_notification_email = "billing-alerts@example.com"
# budget_forecast_alert_threshold_pct = 80

# Scheduled scaling creates Application Auto Scaling schedules. Enable only
# after reviewing the target service and demo timezone.
enable_demo_scheduled_scaling       = false
demo_scale_up_schedule_expression   = "cron(0 8 ? * MON-FRI *)"
demo_scale_down_schedule_expression = "cron(0 19 ? * MON-FRI *)"
demo_scaling_timezone               = "Asia/Ho_Chi_Minh"

# Optional backend self scale-down after the last session ends.
# Keep disabled until the ECS task role/plan are reviewed.
enable_idle_scale_down        = false
target_enable_idle_scale_down = false
idle_scale_down_grace_seconds = 300

# Optional wake-on-demand endpoint. Keep disabled until the Terraform plan is reviewed.
# When enabled, frontend can call VITE_WAKE_BACKEND_URL before opening the WebSocket.
enable_wake_endpoint          = false
wake_endpoint_timeout_seconds = 15

# Health Check Configuration
health_check_interval = 30  # seconds
health_check_timeout  = 5   # seconds
healthy_threshold     = 2   # consecutive successes
unhealthy_threshold   = 3   # consecutive failures

# CloudWatch Logs
log_retention_days = 14  # Retain logs for 14 days

# Manage the watchtower application log group ("livecap") so it gets an explicit
# retention policy. Import the existing group before the first apply:
#   terraform import aws_cloudwatch_log_group.watchtower livecap
# manage_watchtower_log_group = true
# watchtower_log_group_name   = "livecap"

# Amazon Bedrock meeting summary (opt-in). When true, creates a
# bedrock:InvokeModel policy on the task role and enables the feature in the
# container. Requires Bedrock model access enabled in the region.
# enable_meeting_summary = false
# bedrock_model_id       = "anthropic.claude-3-haiku-20240307-v1:0"
# Set bedrock_region only if the model is not available in aws_region.
# bedrock_region         = "us-east-1"

# CloudFront Configuration
cloudfront_price_class = "PriceClass_100" # Cost-focused; use 200/All for more Asia edge coverage.

# WAF Configuration. The origin secret must be generated and supplied through
# the untracked terraform.tfvars file; never commit the real value.
enable_waf = true
# origin_verify_secret = "replace-with-a-random-value-of-at-least-32-characters"
waf_rate_limit = 2000

# TLS/SSL Configuration
# Keep the legacy rollback ALB on its current HTTP origin unless a separate
# legacy certificate/domain is intentionally provisioned.
# alb_ssl_certificate_arn = ""
# backend_domain_name      = ""

# Target ALB production TLS. The certificate must be issued in ap-southeast-1
# and the domain must resolve to the target ALB before CloudFront cutover.
# target_alb_ssl_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/target-cert-id"
# target_backend_domain_name      = "api.livecap.example.com"

# Provide your ACM certificate ARN for a CloudFront custom domain (certificate must be in us-east-1)
# cloudfront_ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abc123..."
# custom_domain = "livecap.example.com"

# Legacy network discovery remains only for the rollback stack.
legacy_availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]
# vpc_id             = "vpc-xxxxx"
# public_subnet_ids  = ["subnet-xxxxx", "subnet-yyyyy"]
# private_subnet_ids = ["subnet-aaaaa", "subnet-bbbbb"]

# Dedicated target VPC defaults:
# VPC 10.20.0.0/16
# Public: 10.20.0.0/24 (1a), 10.20.1.0/24 (1b)
# Private: 10.20.10.0/24 (1a), 10.20.11.0/24 (1b)
# One NAT Gateway is placed in public subnet "a".

# ECR Configuration
ecr_repository_name      = "livecap-backend"
ecr_image_tag_mutability = "IMMUTABLE"
ecr_scan_on_push         = true

# Additional Resource Tags
tags = {
  Owner       = "livecap"
  CostCenter  = "academic-project"
  Terraform   = "true"
}
