# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your deployment

# AWS Configuration
aws_region   = "ap-southeast-1"
environment  = "dev"
project_name = "livecap"

# S3 Bucket Names (must be globally unique)
# If left empty, bucket names will be auto-generated with account ID suffix
# frontend_bucket_name   = "my-company-livecap-frontend-dev"
# transcript_bucket_name = "my-company-livecap-transcripts-dev"

# Transcript Retention
transcript_retention_days = 30  # Auto-delete transcripts after 30 days

# ECS Task Configuration
ecs_task_cpu      = 512   # 0.5 vCPU
ecs_task_memory   = 1024  # 1 GB RAM

# ECS backend scale-to-zero. Keep max=1 while session limits are in-memory.
backend_desired_count = 0
backend_min_capacity  = 0
backend_max_capacity  = 1

autoscaling_target_cpu    = 70  # Scale out when CPU > 70%
autoscaling_target_memory = 80  # Scale out when memory > 80%

# Application Configuration
session_timeout_seconds           = 1800  # 30 minutes
download_link_expiration_seconds  = 86400 # 24 hours
max_speakers                      = 5
max_concurrent_sessions           = 4
max_sessions_per_ip               = 1

# Cost guard. AWS Budget notifications are not real-time and can lag behind usage.
monthly_budget_limit_usd = 50
# budget_notification_email = "billing-alerts@example.com"

# Demo-safe scheduled scaling.
enable_demo_scheduled_scaling       = true
demo_scale_up_schedule_expression   = "cron(0 8 ? * MON-FRI *)"
demo_scale_down_schedule_expression = "cron(0 19 ? * MON-FRI *)"
demo_scaling_timezone               = "Asia/Ho_Chi_Minh"

# Optional backend self scale-down after the last session ends.
# Keep disabled until the ECS task role/plan are reviewed.
enable_idle_scale_down         = false
idle_scale_down_grace_seconds = 300

# Optional wake-on-demand endpoint. Keep disabled until the Terraform plan is reviewed.
# When enabled, frontend can call VITE_WAKE_BACKEND_URL before opening the WebSocket.
enable_wake_endpoint          = false
wake_endpoint_timeout_seconds = 15

# Health Check Configuration
health_check_interval = 30  # seconds
health_check_timeout  = 5   # seconds
healthy_threshold     = 2   # consecutive successes
unhealthy_threshold   = 3   # consecutive failures

# CloudWatch Logs
log_retention_days = 7  # Retain logs for 7 days

# CloudFront Configuration
cloudfront_price_class = "PriceClass_100"  # Use edge locations in North America and Europe

# TLS/SSL Configuration
# Provide an ACM certificate ARN for the backend ALB in the same region as the ALB.
# Leave empty only for development HTTP mode.
# alb_ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/backend-cert-id"
# backend_domain_name = "api.livecap.example.com"

# Provide your ACM certificate ARN for a CloudFront custom domain (certificate must be in us-east-1)
# cloudfront_ssl_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/abc123..."
# custom_domain = "livecap.example.com"

# Network Configuration (optional)
# If not provided, Terraform will use the default VPC and auto-discover subnets
# vpc_id             = "vpc-xxxxx"
# public_subnet_ids  = ["subnet-xxxxx", "subnet-yyyyy"]
# private_subnet_ids = ["subnet-aaaaa", "subnet-bbbbb"]

# ECR Configuration
ecr_repository_name      = "livecap-backend"
ecr_image_tag_mutability = "MUTABLE"
ecr_scan_on_push         = true

# Additional Resource Tags
tags = {
  Owner       = "DevOps Team"
  CostCenter  = "Engineering"
  Terraform   = "true"
}
