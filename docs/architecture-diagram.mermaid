flowchart TB
    User["🌐 Browser<br/>livecap.logantai.com"]

    subgraph Global["AWS Global Edge"]
        CFWAF["CloudFront WAF<br/>BLOCK + rate-limit"]
        CF["CloudFront Distribution<br/>+ CloudFront Function (SPA routing)"]
    end

    subgraph USE1["us-east-1"]
        Bedrock["Amazon Bedrock<br/>Claude — meeting notes"]
        CE["Cost Explorer API"]
    end

    subgraph Region["ap-southeast-1"]
        S3F["S3 Frontend Bucket<br/>private • OAC"]
        Wake["Wake Lambda<br/>Function URL • AWS_IAM"]
        ECR["ECR<br/>immutable Git-SHA image"]
        S3T["S3 Transcript Bucket<br/>private • TTL 14d • no raw audio"]
        SM["Secrets Manager<br/>Stripe keys"]
        Cognito["Amazon Cognito<br/>User Pool + Google IdP<br/>admin group"]

        subgraph Data["DynamoDB (on-demand + TTL)"]
            DDBs["sessions-dev"]
            DDBh["transcript-history-dev"]
            DDBu["usage-dev (quota)"]
            DDBa["admin audit log"]
        end

        subgraph AI["Streaming AI Services"]
            Transcribe["Amazon Transcribe<br/>vi + en + custom vocab"]
            Translate["Amazon Translate"]
            Polly["Amazon Polly (TTS)"]
            Comprehend["Amazon Comprehend"]
        end

        subgraph VPC["Custom VPC 10.20.0.0/16 — 2 AZ"]
            ALBWAF["Regional ALB WAF<br/>BLOCK"]
            ALB["Application Load Balancer<br/>HTTPS • internet-facing"]

            subgraph AZA["ap-southeast-1a"]
                PubA["Public 10.20.0.0/24"]
                PrivA["Private 10.20.10.0/24"]
                NATA["NAT Gateway A"]
            end
            subgraph AZB["ap-southeast-1b"]
                PubB["Public 10.20.1.0/24"]
                PrivB["Private 10.20.11.0/24"]
                NATB["NAT Gateway B"]
            end

            ECS["ECS Fargate Service<br/>desired 0–1 • scale-to-zero<br/>(autoscaling policies exist, cap raised only after load-test)"]
            Task["Fargate Task<br/>FastAPI • port 8000 • no public IP<br/>+ X-Ray sidecar"]
        end

        subgraph Obs["Observability & Security"]
            CW["CloudWatch<br/>Logs • Metrics • Dashboard • 6 Alarms"]
            SNS["SNS Topic"]
            GD["GuardDuty"]
            SH["Security Hub"]
            FL["VPC Flow Logs"]
            Budget["AWS Budget $50/mo"]
        end
    end

    Stripe["💳 Stripe<br/>Checkout • Portal • Webhook"]

    %% Entry path
    User -->|HTTPS + WSS| CFWAF --> CF
    CF -->|OAC| S3F
    CF -->|/api/wake • OAC SigV4| Wake
    CF -->|/api/* • /ws/*| ALBWAF --> ALB
    PubA --- ALB
    PubB --- ALB
    ALB -->|target group :8000| Task
    ECS -->|maintains ≤ tasks| Task
    PrivA -.->|placement| Task
    PrivB -.->|placement| Task
    Wake -->|Describe/UpdateService| ECS

    %% Egress via NAT
    Task --> NATA --> Transcribe
    Task --> NATB
    NATA --> Translate
    NATA --> Polly
    NATA --> Comprehend
    NATA --> Bedrock
    NATA --> CE

    %% Data + identity
    Task --> DDBs
    Task --> DDBh
    Task --> DDBu
    Task --> DDBa
    Task -->|export TXT| S3T
    Task -->|validate token / admin| Cognito
    Task -->|read secrets| SM
    Task -->|checkout / portal| Stripe
    Stripe -->|webhook /api/billing/webhook| ALB
    ECR -.->|pull image| Task

    %% Observability
    Task -.-> CW
    ALB -.-> CW
    Wake -.-> CW
    CW --> SNS
    GD --> SNS
    FL -.-> CW

    classDef edge fill:#0a9c88,stroke:#087,color:#fff
    classDef data fill:#102247,stroke:#081533,color:#fff
    classDef ai fill:#1f6feb,stroke:#0d47a1,color:#fff
    classDef ext fill:#635bff,stroke:#4b45c6,color:#fff
    class CFWAF,CF edge
    class DDBs,DDBh,DDBu,DDBa,S3F,S3T data
    class Transcribe,Translate,Polly,Comprehend,Bedrock ai
    class Stripe ext
